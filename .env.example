# Supabase public credentials (optional in local dev, fallback data provider will be active if not set)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (for ETL push script only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
